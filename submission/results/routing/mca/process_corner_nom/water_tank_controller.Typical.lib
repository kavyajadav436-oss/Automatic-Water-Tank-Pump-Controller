library (water_tank_controller) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00146,  0.00429,  0.01257,  0.03681,  0.10783,  0.31587");
  }

  cell ("water_tank_controller") {
    interface_timing : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0113;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.27184");
	}
	cell_fall(scalar) {
          values("0.27752");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.47709");
	}
	cell_fall(scalar) {
          values("0.27752");
	}
      }
    }
    pin("high_level") {
      direction : input;
      capacitance : 0.0029;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.07699");
	}
	fall_constraint(scalar) {
          values("-0.10918");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.29285");
	}
	fall_constraint(scalar) {
          values("0.32130");
	}
      }
    }
    pin("low_level") {
      direction : input;
      capacitance : 0.0028;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.21751");
	}
	fall_constraint(scalar) {
          values("-0.18354");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.27604");
	}
	fall_constraint(scalar) {
          values("0.20743");
	}
      }
    }
    pin("pump_on") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.23578,1.24078,1.25283,1.28229,1.36270,1.59580,2.28030");
	}
	rise_transition(template_1) {
          values("0.01730,0.02175,0.03423,0.07132,0.18452,0.52134,1.50655");
	}
	cell_fall(template_1) {
          values("1.23208,1.23667,1.24697,1.26791,1.31334,1.42943,1.76365");
	}
	fall_transition(template_1) {
          values("0.01761,0.02071,0.02791,0.04583,0.09405,0.24287,0.69553");
	}
      }
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0027;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.01674");
	}
	fall_constraint(scalar) {
          values("-0.12589");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.35310");
	}
	fall_constraint(scalar) {
          values("0.33801");
	}
      }
    }
  }

}

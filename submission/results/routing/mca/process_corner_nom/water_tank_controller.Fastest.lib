library (water_tank_controller) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00153,  0.00471,  0.01445,  0.04434,  0.13605,  0.41749");
  }

  cell ("water_tank_controller") {
    interface_timing : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0113;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.27184");
	}
	cell_fall(scalar) {
          values("0.27752");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.47709");
	}
	cell_fall(scalar) {
          values("0.27752");
	}
      }
    }
    pin("high_level") {
      direction : input;
      capacitance : 0.0029;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.05323");
	}
	fall_constraint(scalar) {
          values("-0.04771");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.16895");
	}
	fall_constraint(scalar) {
          values("0.18877");
	}
      }
    }
    pin("low_level") {
      direction : input;
      capacitance : 0.0029;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.12574");
	}
	fall_constraint(scalar) {
          values("-0.10306");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.15642");
	}
	fall_constraint(scalar) {
          values("0.11523");
	}
      }
    }
    pin("pump_on") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.23604,1.23973,1.24908,1.27397,1.34758,1.57248,2.26559");
	}
	rise_transition(template_1) {
          values("0.01208,0.01552,0.02592,0.05930,0.16651,0.49611,1.50708");
	}
	cell_fall(template_1) {
          values("1.23232,1.23570,1.24369,1.26050,1.29869,1.40349,1.72255");
	}
	fall_transition(template_1) {
          values("0.01268,0.01507,0.02089,0.03523,0.07665,0.21237,0.63756");
	}
      }
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0028;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.01510");
	}
	fall_constraint(scalar) {
          values("-0.05847");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.20708");
	}
	fall_constraint(scalar) {
          values("0.19953");
	}
      }
    }
  }

}

library (water_tank_controller) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00551,  0.01830,  0.06076,  0.20175,  0.66987");
  }

  cell ("water_tank_controller") {
    interface_timing : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0109;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.26965");
	}
	cell_fall(scalar) {
          values("0.27613");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.47364");
	}
	cell_fall(scalar) {
          values("0.27613");
	}
      }
    }
    pin("high_level") {
      direction : input;
      capacitance : 0.0028;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.10701");
	}
	fall_constraint(scalar) {
          values("-0.21644");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.72995");
	}
	fall_constraint(scalar) {
          values("0.64235");
	}
      }
    }
    pin("low_level") {
      direction : input;
      capacitance : 0.0027;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.52594");
	}
	fall_constraint(scalar) {
          values("-0.38407");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.69187");
	}
	fall_constraint(scalar) {
          values("0.44254");
	}
      }
    }
    pin("pump_on") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.23055,1.24084,1.26778,1.34009,1.56535,2.30566,4.77589");
	}
	rise_transition(template_1) {
          values("0.03045,0.03923,0.06658,0.15756,0.47272,1.52768,5.00394");
	}
	cell_fall(template_1) {
          values("1.22716,1.23710,1.26113,1.31482,1.45058,1.87170,3.26450");
	}
	fall_transition(template_1) {
          values("0.03255,0.03946,0.05710,0.10725,0.27066,0.84365,2.74176");
	}
      }
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0026;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.00633");
	}
	fall_constraint(scalar) {
          values("-0.24751");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.83062");
	}
	fall_constraint(scalar) {
          values("0.67341");
	}
      }
    }
  }

}

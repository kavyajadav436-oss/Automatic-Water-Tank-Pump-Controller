library (water_tank_controller) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00146,  0.00429,  0.01257,  0.03681,  0.10783,  0.31587");
  }

  cell ("water_tank_controller") {
    interface_timing : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0109;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.26965");
	}
	cell_fall(scalar) {
          values("0.27613");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.47364");
	}
	cell_fall(scalar) {
          values("0.27613");
	}
      }
    }
    pin("high_level") {
      direction : input;
      capacitance : 0.0028;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.07676");
	}
	fall_constraint(scalar) {
          values("-0.10667");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.29046");
	}
	fall_constraint(scalar) {
          values("0.31591");
	}
      }
    }
    pin("low_level") {
      direction : input;
      capacitance : 0.0028;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.21458");
	}
	fall_constraint(scalar) {
          values("-0.18145");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.27313");
	}
	fall_constraint(scalar) {
          values("0.20534");
	}
      }
    }
    pin("pump_on") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.23089,1.23588,1.24794,1.27739,1.35780,1.59088,2.27537");
	}
	rise_transition(template_1) {
          values("0.01730,0.02175,0.03423,0.07132,0.18452,0.52136,1.50653");
	}
	cell_fall(template_1) {
          values("1.22751,1.23210,1.24239,1.26333,1.30877,1.42486,1.75908");
	}
	fall_transition(template_1) {
          values("0.01761,0.02071,0.02791,0.04583,0.09405,0.24288,0.69554");
	}
      }
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0027;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.02036");
	}
	fall_constraint(scalar) {
          values("-0.12129");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.34685");
	}
	fall_constraint(scalar) {
          values("0.33053");
	}
      }
    }
  }

}

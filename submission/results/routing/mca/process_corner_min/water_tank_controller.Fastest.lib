library (water_tank_controller) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00153,  0.00471,  0.01445,  0.04434,  0.13605,  0.41749");
  }

  cell ("water_tank_controller") {
    interface_timing : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0110;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.26965");
	}
	cell_fall(scalar) {
          values("0.27613");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.47364");
	}
	cell_fall(scalar) {
          values("0.27613");
	}
      }
    }
    pin("high_level") {
      direction : input;
      capacitance : 0.0029;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.05305");
	}
	fall_constraint(scalar) {
          values("-0.04547");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.16707");
	}
	fall_constraint(scalar) {
          values("0.18499");
	}
      }
    }
    pin("low_level") {
      direction : input;
      capacitance : 0.0029;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.12360");
	}
	fall_constraint(scalar) {
          values("-0.10169");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.15421");
	}
	fall_constraint(scalar) {
          values("0.11384");
	}
      }
    }
    pin("pump_on") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.23103,1.23473,1.24407,1.26896,1.34257,1.56745,2.26057");
	}
	rise_transition(template_1) {
          values("0.01208,0.01552,0.02592,0.05930,0.16652,0.49610,1.50703");
	}
	cell_fall(template_1) {
          values("1.22765,1.23103,1.23902,1.25583,1.29401,1.39882,1.71790");
	}
	fall_transition(template_1) {
          values("0.01268,0.01507,0.02089,0.03522,0.07665,0.21235,0.63766");
	}
      }
    }
    pin("rst") {
      direction : input;
      capacitance : 0.0028;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.01724");
	}
	fall_constraint(scalar) {
          values("-0.05478");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.20288");
	}
	fall_constraint(scalar) {
          values("0.19430");
	}
      }
    }
  }

}

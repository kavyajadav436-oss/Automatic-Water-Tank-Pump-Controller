        RECT 4.400 26.840 37.275 28.240 ;
        RECT 3.990 24.840 37.675 26.840 ;
        RECT 4.400 23.440 37.675 24.840 ;
        RECT 3.990 21.440 37.675 23.440 ;
        RECT 4.400 20.040 37.675 21.440 ;
        RECT 3.990 10.715 37.675 20.040 ;

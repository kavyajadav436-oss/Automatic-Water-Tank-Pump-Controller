VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO water_tank_controller
  CLASS BLOCK ;
  FOREIGN water_tank_controller ;
  ORIGIN 0.000 0.000 ;
  SIZE 41.675 BY 52.395 ;
  PIN VGND
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER met4 ;
        RECT 11.815 10.640 13.415 41.140 ;
    END
    PORT
      LAYER met4 ;
        RECT 19.405 10.640 21.005 41.140 ;
    END
    PORT
      LAYER met4 ;
        RECT 26.995 10.640 28.595 41.140 ;
    END
    PORT
      LAYER met4 ;
        RECT 34.585 10.640 36.185 41.140 ;
    END
    PORT
      LAYER met5 ;
        RECT 5.280 17.115 36.185 18.715 ;
    END
    PORT
      LAYER met5 ;
        RECT 5.280 24.590 36.185 26.190 ;
    END
    PORT
      LAYER met5 ;
        RECT 5.280 32.065 36.185 33.665 ;
    END
    PORT
      LAYER met5 ;
        RECT 5.280 39.540 36.185 41.140 ;
    END
  END VGND
  PIN VPWR
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER met4 ;
        RECT 8.515 10.640 10.115 41.040 ;
    END
    PORT
      LAYER met4 ;
        RECT 16.105 10.640 17.705 41.040 ;
    END
    PORT
      LAYER met4 ;
        RECT 23.695 10.640 25.295 41.040 ;
    END
    PORT
      LAYER met4 ;
        RECT 31.285 10.640 32.885 41.040 ;
    END
    PORT
      LAYER met5 ;

    END
    PORT
      LAYER met5 ;
        RECT 5.280 21.290 36.120 22.890 ;
    END
    PORT
      LAYER met5 ;
        RECT 5.280 28.765 36.120 30.365 ;
    END
    PORT
      LAYER met5 ;
        RECT 5.280 36.240 36.120 37.840 ;
    END
  END VPWR
  PIN clk
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.852000 ;
    PORT
      LAYER met3 ;
        RECT 0.000 30.640 4.000 31.240 ;
    END
  END clk
  PIN high_level
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.196500 ;
    PORT
      LAYER met3 ;
        RECT 0.000 20.440 4.000 21.040 ;
    END
  END high_level
  PIN low_level
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.196500 ;
    PORT
      LAYER met3 ;
        RECT 0.000 23.840 4.000 24.440 ;
    END
  END low_level
  PIN pump_on
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    ANTENNADIFFAREA 0.445500 ;
    PORT
      LAYER met3 ;
        RECT 37.675 27.240 41.675 27.840 ;
    END
  END pump_on
  PIN rst
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.196500 ;
    PORT
      LAYER met3 ;
        RECT 0.000 27.240 4.000 27.840 ;
    END
  END rst
  OBS
      LAYER nwell ;
        RECT 5.330 10.795 36.070 40.990 ;
      LAYER li1 ;
        RECT 5.520 10.795 35.880 40.885 ;
      LAYER met1 ;
        RECT 4.210 10.640 37.190 41.040 ;
      LAYER met2 ;
        RECT 4.230 10.695 37.170 40.985 ;
      LAYER met3 ;
